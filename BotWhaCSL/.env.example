# ── Supabase (OBLIGATORIO) ─────────────────────────────────────────
# Crea un proyecto en https://supabase.com/dashboard y copia estos
# valores desde Project Settings → API.
# ⚠️ Usa la key "service_role" (secreta, solo server). NUNCA la anon.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── OpenAI (proveedor de IA por defecto) ───────────────────────────
# Crea una key en https://platform.openai.com/api-keys
# También se puede configurar proveedor/modelo desde el dashboard:
# Canales → tarjeta "Inteligencia artificial (IA)" (manda sobre esto).
OPENAI_API_KEY=sk-...
# Modelo recomendado: gpt-4o-mini (~US$0.15 por millón de tokens).
OPENAI_MODEL=gpt-4o-mini

# ── Respuestas automáticas (opcionales) ────────────────────────────
# Mensajes escritos hace más de estas horas (p.ej. con el bot apagado)
# se guardan pero no se responden solos. Por defecto 24.
# AUTO_REPLY_MAX_AGE_HOURS=24
# Llamadas simultáneas a la IA por proceso (con muchos clientes a la vez
# esperan su turno en vez de chocar con el límite del proveedor). Por
# defecto 6.
# LLM_MAX_CONCURRENCY=6
